# EquiGig AI Agent Environment Configuration Example

# Gemini API Key (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Endee.io Vector Database Configuration
ENDEE_API_KEY=your_endee_api_token_here
ENDEE_URL=http://localhost:8080/api/v2
ENDEE_COLLECTION=equigig_contracts

# Server Settings
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
